        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n%% =====================================================\n%% DATA PREPARATION LAYER\n%% =====================================================\n\nA[\&quot;Online Retail Customer Dataset\&quot;]\n\nsubgraph DP[\&quot;Data Preparation Layer\&quot;]\n\nB[\&quot;Data Exploration&lt;br/&gt;(EDA &amp; Data Understanding)\&quot;]\n\nC[\&quot;Data Cleaning &amp; Preprocessing&lt;br/&gt;(Missing Values, Outliers &amp; Data Cleaning)\&quot;]\n\nD[\&quot;RFM Feature Engineering&lt;br/&gt;(Recency, Frequency, Monetary Scores)\&quot;]\n\nE[\&quot;Customer Behaviour Segmentation&lt;br/&gt;(Behaviour-Based RFM Segments)\&quot;]\n\nF[\&quot;Feature Encoding &amp; Data Transformation\&quot;]\n\nend\n\nA --&gt; B\nB --&gt; C\nC --&gt; D\nD --&gt; E\nE --&gt; F\n\n%% =====================================================\n%% PREDICTIVE ANALYTICS LAYER\n%% =====================================================\n\nsubgraph PA[\&quot;Predictive Analytics Layer\&quot;]\n\nG[\&quot;Train-Test Split\&quot;]\n\nH[\&quot;Class Balancing (SMOTE)\&quot;]\n\nI[\&quot;Random Forest Churn Prediction Model\&quot;]\n\nJ[\&quot;Churn Probability Prediction\&quot;]\n\nK[\&quot;Customer Churn Risk Classification\&quot;]\n\nend\n\nF --&gt; G\nG --&gt; H\nH --&gt; I\nI --&gt; J\nJ --&gt; K\n\n%% =====================================================\n%% DECISION INTELLIGENCE LAYER\n%% =====================================================\n\nsubgraph DI[\&quot;Decision Intelligence Layer\&quot;]\n\nL[\&quot;Priority Scoring\&quot;]\n\nM[\&quot;Business Rule Recommendation Engine\&quot;]\n\nN[\&quot;SHAP Explainability\&quot;]\n\nO[\&quot;DiCE Counterfactual Explanations\&quot;]\n\nend\n\nE --&gt; L\nJ --&gt; L\n\nL --&gt; M\nI --&gt; N\nI --&gt; O\n\n%% =====================================================\n%% DECISION SUPPORT LAYER\n%% =====================================================\n\nsubgraph DSS[\&quot;Decision Support Dashboard (Streamlit)\&quot;]\n\nP[\&quot;Executive Dashboard\&quot;]\n\nQ[\&quot;Customer Behaviour Segments\&quot;]\n\nR[\&quot;Retention Priority Centre\&quot;]\n\nS[\&quot;Customer Profile\&quot;]\n\nT[\&quot;Counterfactual Actions\&quot;]\n\nU[\&quot;Churn Drivers &amp; Explainability\&quot;]\n\nend\n\nM --&gt; P\nE --&gt; Q\nL --&gt; R\nM --&gt; S\nO --&gt; T\nN --&gt; U\n\n%% =====================================================\n%% BUSINESS OUTCOME LAYER\n%% =====================================================\n\nsubgraph BO[\&quot;Business Outcome\&quot;]\n\nV[\&quot;Manager Decision Making\&quot;]\n\nW[\&quot;Targeted Retention Strategy\&quot;]\n\nX[\&quot;Improved Customer Retention&lt;br/&gt;Reduced Customer Churn\&quot;]\n\nend\n\nP --&gt; V\nQ --&gt; V\nR --&gt; V\nS --&gt; V\nT --&gt; V\nU --&gt; V\n\nV --&gt; W\nW --&gt; X&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6-ClOZew5cYv9DLX4cJN-1">
